   "rows": [
    {
     "J1YX9kmM": "870000019",
     "T7aEx3Mj": "An improved festival cap, made sturdier and lighter with red feathers.",
     "VC9F3eJn": "We moogles improved Santa's hat, kupo! Red feathers made it sturdier and lighter, kupo! With this, you can become a splendid Santa too, kupo! If you become Santa, will you give me a present, kupo?"
    },
    {
     "J1YX9kmM": "870000018",
     "T7aEx3Mj": "An improved festival robe, made sturdier and lighter with white feathers.",
     "VC9F3eJn": "We moogles improved Santa's clothes, kupo! White feathers made them sturdier and lighter, kupo! Next, let's make them even more festive with a big tail, colorful pom-poms, and a tree on the back, kupo! ...You don't want those, kupo? That's a shame. I thought they would look really cool, kupo!"
    }
   ]
